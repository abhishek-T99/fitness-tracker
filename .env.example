# -----------------------------------------------------------------------
# Copy this file to .env and fill in your values.
#
# These values are for Docker Compose. For local (non-Docker) development,
# use backend/.env instead (DB_HOST=127.0.0.1, REDIS_URL=redis://127...).
# -----------------------------------------------------------------------

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,fittrack.local
CORS_ALLOWED_ORIGINS=https://fittrack.local,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://fittrack.local,http://localhost:5173

# PostgreSQL — DB_HOST must be the Docker service name, not 127.0.0.1
DB_NAME=fittrack
DB_USER=fittrack
DB_PASSWORD=fittrack
DB_HOST=postgres
DB_PORT=5432

# Redis — hostnames must match the Docker service names
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# Email
# Use console backend for dev (emails print to the backend container logs).
# Switch to smtp for production and fill in SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=FitTrack <noreply@fittrack.app>
FRONTEND_URL=https://fittrack.local

# Flower — Celery monitoring UI (only used with: docker compose --profile monitoring up)
# Accessible at https://fittrack.local/flower/  — change before exposing to a network.
FLOWER_USER=admin
FLOWER_PASSWORD=flower

# Frontend dev server — Nginx proxies /api, so this points at the backend service
VITE_API_PROXY_TARGET=http://backend:8000

# Nginx / HMR — tells the Vite HMR client to connect back via Nginx on port 443
# instead of the internal Vite port 5173.
